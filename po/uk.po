#: manahost/__init__.py:27
msgid "ManaTools manahost"
msgstr "manahost з ManaTools"

#: manahost/__init__.py:30
msgid ""
"Graphical hostname control tool using org.freedesktop.hostname1 with a "
"backend-independent ManaTools Abstract User Interface."
msgstr ""
"Графічний інструмент для керування назвою вузла за допомогою "
"org.freedesktop.hostname1 з незалежним від модуля інтерфейсом абстрагування "
"ManaTools."

#: manahost/__init__.py:35
msgid "Manage the system hostname through the systemd hostname1 API."
msgstr ""
"Керування назвою вузла системи за допомогою програмного інтерфейсу hostname1 "
"з systemd."

