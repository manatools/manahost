#: manahost/__init__.py:27
msgid "ManaTools manahost"
msgstr "manahost от ManaTools"

#: manahost/__init__.py:30
msgid ""
"Graphical hostname control tool using org.freedesktop.hostname1 with a "
"backend-independent ManaTools Abstract User Interface."
msgstr ""
"Графический инструмент для управления именем узла с помощью "
"org.freedesktop.hostname1 с независимым от бэкенда интерфейсом "
"абстрагирования ManaTools."

